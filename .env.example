# === OpenRouter (required) ===
# Your API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# === Secrets (generated by scripts/bootstrap.sh, or random hex yourself) ===
WEBUI_SECRET_KEY=
SEARXNG_SECRET=
OPEN_TERMINAL_API_KEY=

# === Optional ===
# Host folder exposed read-only at /workspace inside the agent terminal.
# Default: ./sources (drop any project inside it, no path edits needed).
# AGENT_WORKSPACE_DIR=/absolute/path/to/your/codebase
